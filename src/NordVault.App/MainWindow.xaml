<Window x:Class="NordVault.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NordVault · Diskar, USB och filer" Width="1200" Height="820" MinWidth="980" MinHeight="680" WindowStartupLocation="CenterScreen">
  <Grid Background="#F3F6F9">
    <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="#16283F">
      <Grid Margin="24,32"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="◈  NordVault" Foreground="White" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="Dina data. Ditt skydd." Foreground="#A7B7CA" Margin="0,10,0,38" FontSize="12" /></StackPanel>
        <StackPanel Grid.Row="1"><Border Background="#29415A" CornerRadius="7" Padding="13,12"><TextBlock Text="◉  Diskar &amp; USB" Foreground="White" FontWeight="SemiBold" /></Border><Button Content="Kryptering" Click="NavEncryption_Click" Background="Transparent" BorderThickness="0" Foreground="#A7B7CA" HorizontalContentAlignment="Left" Margin="0,15,0,0" /><Button Content="Filkryptering" Click="NavFiles_Click" Background="Transparent" BorderThickness="0" Foreground="#A7B7CA" HorizontalContentAlignment="Left" /><Button Content="Mitt valv" Click="NavVault_Click" Background="Transparent" BorderThickness="0" Foreground="#A7B7CA" HorizontalContentAlignment="Left" /><Button Content="Lösenord &amp; länkar" Click="NavPasswords_Click" Background="Transparent" BorderThickness="0" Foreground="#A7B7CA" HorizontalContentAlignment="Left" /><Button Content="Rensning" Click="NavCleaning_Click" Background="Transparent" BorderThickness="0" Foreground="#A7B7CA" HorizontalContentAlignment="Left" /><Button Content="Återställning" Click="NavRecovery_Click" Background="Transparent" BorderThickness="0" Foreground="#A7B7CA" HorizontalContentAlignment="Left" /></StackPanel>
        <StackPanel Grid.Row="3"><TextBlock Text="PRIVAT FÖRHANDSVERSION" Foreground="#A7B7CA" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="v0.4.4 · Windows 11" Foreground="#A7B7CA" Margin="0,8,0,0" FontSize="12" /><TextBlock Text="BitLocker + GnuPG" Foreground="#A7B7CA" Margin="0,5,0,0" FontSize="11" /></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="30,27,30,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Diskar, USB &amp; filer" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="Skydda hela volymer eller enskilda filer med lösenord." Foreground="{StaticResource Muted}" Margin="0,6,0,18" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="AppLockButton" Content="Lås appen" Click="AppLock_Click" /><Button x:Name="AdminButton" Content="Administratör" Click="Admin_Click" /><Button x:Name="RefreshButton" Content="↻  Uppdatera" Click="Refresh_Click" /></StackPanel></Grid>
      <Border Grid.Row="1" CornerRadius="9" Background="#E4F0EC" Padding="17,12" Margin="0,0,0,18"><StackPanel><TextBlock x:Name="EnvironmentText" Text="Diskar och USB" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="EnvironmentDetail" Text="Inga åtgärder startas automatiskt. Filkryptering och valv kan användas direkt." Foreground="#49665F" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" /><TextBlock x:Name="DiskReadText" Text="Väntar på diskstatus…" Foreground="#49665F" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" /></StackPanel></Border>
      <TabControl x:Name="MainTabs" Grid.Row="2" Background="Transparent" BorderThickness="0">
        <TabItem Header="Översikt &amp; kryptering"><Grid Margin="0,15,0,0"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <DataGrid x:Name="VolumeGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E8EDF2" RowHeight="48" ColumnHeaderHeight="38" Background="White" BorderBrush="#DDE5EC" SelectionChanged="Volume_Changed">
            <DataGrid.Columns><DataGridTextColumn Header="Enhet" Binding="{Binding DisplayName}" Width="230" /><DataGridTextColumn Header="Typ" Binding="{Binding MediaText}" Width="130" /><DataGridTextColumn Header="Storlek" Binding="{Binding Capacity}" Width="85" /><DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="210" /></DataGrid.Columns>
          </DataGrid>
          <Border Grid.Row="1" Background="White" CornerRadius="9" Padding="20,16" Margin="0,15,0,0"><StackPanel><TextBlock x:Name="SelectionTitle" Text="Välj en disk i listan" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="SelectionDetail" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,14" /><WrapPanel><Button x:Name="EncryptButton" Content="Förbered kryptering…" Style="{StaticResource Primary}" Click="Encrypt_Click" /><Button x:Name="UnlockButton" Content="Lås upp…" Click="Unlock_Click" /><Button x:Name="LockButton" Content="Lås volym" Click="Lock_Click" /><Button x:Name="ProtectButton" Content="Återaktivera skydd" Click="Protect_Click" /></WrapPanel><TextBlock Text="XTS-AES-256 · hela volymen · återställningsnyckel före start" Foreground="{StaticResource Muted}" FontSize="12" /></StackPanel></Border>
        </Grid></TabItem>
        <TabItem Header="Filkryptering"><ContentControl x:Name="FileToolsHost" /></TabItem>
        <TabItem Header="Mitt valv"><ContentControl x:Name="VaultToolsHost" /></TabItem><TabItem Header="Lösenord &amp; länkar"><ContentControl x:Name="PasswordToolsHost" /></TabItem><TabItem Header="Rensning"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,17,0,0">
          <Border Background="White" CornerRadius="9" Padding="22" Margin="0,0,0,16"><StackPanel><TextBlock Text="Rensa ledigt utrymme" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="Välj först en krypterad volym i översikten. Windows rensar utrymmet efter tidigare raderade filer; dina befintliga filer behålls." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,13" /><TextBlock x:Name="WipeDetail" TextWrapping="Wrap" Margin="0,0,0,12" /><WrapPanel><Button x:Name="WipeButton" Content="Rensa ledigt utrymme…" Click="Wipe_Click" Style="{StaticResource Primary}" /><Button x:Name="CancelWipeButton" Content="Avbryt pågående rensning" Click="CancelWipe_Click" /></WrapPanel></StackPanel></Border>
          <Border Background="White" CornerRadius="9" Padding="22"><StackPanel><TextBlock Text="Förstör en vald fil på HDD" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="En fil åt gången, med Microsoft SDelete. Funktionen kräver identifierad HDD och NTFS. Välj inte en fil du vill behålla; rensningen kan inte ångras." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,13" /><WrapPanel><Button x:Name="ShredButton" Content="Välj fil för förstöring…" Click="Shred_Click" /><Button x:Name="ToolButton" Content="SDelete och licens" Click="Tool_Click" /></WrapPanel><TextBlock x:Name="ToolDetail" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" /></StackPanel></Border>
          <Border Background="#FFF2DB" CornerRadius="9" Padding="17" Margin="0,16,0,0"><TextBlock Text="SSD och USB-flash: rensning av ledigt utrymme kan inte garantera att tidigare data i reservceller försvinner. Kryptera från början. Kopior, säkerhetskopior och ögonblicksbilder rensas separat." TextWrapping="Wrap" Foreground="#73551D" FontSize="13" /></Border>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="Om &amp; återställning"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22,22,22,0"><TextBlock Text="Ett eget gränssnitt. Etablerade motorer." FontSize="24" FontWeight="SemiBold" /><TextBlock Text="NordVault använder Windows BitLocker för systemdiskar, datadiskar och USB. Enskilda filer krypteras med GnuPG, lösenord och integritetskontroll. Systemdisken skyddas med TPM + PIN. USB och datadiskar öppnas med lösenord. Kräver BitLocker i Windows Pro, Enterprise eller Education." TextWrapping="Wrap" Margin="0,15,0,20" Foreground="{StaticResource Muted}" /><TextBlock Text="Förvara återställningsnyckeln separat" FontWeight="SemiBold" FontSize="18" /><TextBlock Text="Spara nyckeln på en annan fysisk enhet och håll den offline. Programmet läser tillbaka filen innan kryptering kan starta. Nyckeln kan låsa upp volymen om du glömmer lösenordet. Windows återställningsskärm hanterar systemdisken; datadiskar kan öppnas här." TextWrapping="Wrap" Margin="0,10,0,20" Foreground="{StaticResource Muted}" /><TextBlock Text="Förhandsversion med tydliga gränser" FontWeight="SemiBold" FontSize="18" /><TextBlock Text="Koden har automatiska säkerhetstester, men saknar ännu oberoende granskning och tester på riktiga krypterade diskar. Testa först på en tom reserv-USB. Programmet garanterar inte buggfrihet och ersätter inte en säkerhetskopia." TextWrapping="Wrap" Margin="0,10,0,20" Foreground="{StaticResource Muted}" /><Button Content="Öppna projektets instruktioner" Click="Docs_Click" HorizontalAlignment="Left" /></StackPanel></ScrollViewer></TabItem>
      </TabControl>
      <Border Grid.Row="3" Background="#E8EEF4" CornerRadius="7" Padding="13,10" Margin="0,16,0,10"><StackPanel><TextBlock x:Name="ActivityText" Text="Redo. Välj en volym för att se möjliga åtgärder." TextWrapping="Wrap" FontSize="12" /><ProgressBar x:Name="BusyProgress" Height="3" Margin="0,7,0,0" IsIndeterminate="True" Visibility="Collapsed" /></StackPanel></Border>
      <TextBlock Grid.Row="4" Text="Privat förhandsversion · inga nycklar eller lösenord i programmets aktivitetslogg" FontSize="11" Foreground="{StaticResource Muted}" />
    </Grid>
  </Grid>
</Window>
