{
  "manifest_version": 2,
  "name": "NordVault",
  "version": "0.4.1",
  "description": "Sparar och fyller i inloggningar från ditt krypterade NordVault-valv.",
  "browser_specific_settings": {
    "gecko": {
      "id": "nordvault@nordvault.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["nativeMessaging", "storage", "tabs"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    { "matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "browser_action": {
    "default_title": "NordVault",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": { "48": "icon.svg", "96": "icon.svg" }
}
